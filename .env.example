# Gmail account used to send tracked emails
GMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your normal password)
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account
GMAIL_APP_PASSWORD=

# Base URL of this deployment (used to build the tracking pixel URL in emails)
# On Vercel this is set automatically via VERCEL_URL, but you can override it here
# PIXEL_BASE_URL=https://your-project.vercel.app
